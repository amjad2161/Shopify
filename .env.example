# Smart import — multi-source aggregation, cheapest price, AI trend scoring
# CATALOG_CHEAPEST_SOURCE_ONLY=1
# CATALOG_TARGET_COUNTRY=IL
# CATALOG_TARGET_REGION=
# CATALOG_TARGET_LOCALE=he-IL
# CATALOG_MIN_PROFIT_PERCENT=40
