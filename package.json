{
  "name": "lumen-atelier",
  "private": true,
  "sideEffects": false,
  "version": "2026.4.2",
  "type": "module",
  "scripts": {
    "predev": "vite-node scripts/ensure-store-env.ts",
    "prebuild": "vite-node scripts/ensure-store-env.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "shopify hydrogen build --codegen",
    "dev": "shopify hydrogen dev --codegen",
    "preview": "shopify hydrogen preview --build",
    "lint": "eslint --no-error-on-unmatched-pattern .",
    "typecheck": "react-router typegen && tsc --noEmit",
    "codegen": "shopify hydrogen codegen && react-router typegen",
    "store:link": "npm exec shopify -- hydrogen link",
    "store:env": "npm exec shopify -- hydrogen env pull --force",
    "store:setup": "npm exec shopify -- auth login && npm run store:link && npm run store:env",
    "automate": "node --experimental-strip-types scripts/automation/index.ts",
    "automate:ci": "node --experimental-strip-types scripts/automation/index.ts --mode=ci",
    "automate:full": "node --experimental-strip-types scripts/automation/index.ts --mode=full --production",
    "catalog:plan": "CATALOG_CLI_MODE=plan node --experimental-strip-types scripts/catalog/index.ts",
    "catalog:sync": "node --experimental-strip-types scripts/catalog/index.ts",
    "catalog:smart-sync": "node --experimental-strip-types scripts/catalog/index.ts --import-only",
    "catalog:trends": "CATALOG_CLI_MODE=trends node --experimental-strip-types scripts/catalog/index.ts",
    "catalog:categories": "node --experimental-strip-types scripts/catalog/index.ts --categories-only",
    "ci": "npm run automate:ci"
  },
  "prettier": "@shopify/prettier-config",
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@shopify/hydrogen": "2026.4.2",
    "graphql": "^16.10.0",
    "graphql-tag": "^2.12.6",
    "gsap": "^3.15.0",
    "isbot": "^5.1.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.14.0",
    "react-router-dom": "7.14.0",
    "tailwindcss": "^4.1.6",
    "three": "^0.170.0",
    "web-vitals": "^5.0.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@eslint/compat": "^1.2.5",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@graphql-codegen/cli": "5.0.2",
    "@react-router/dev": "7.14.0",
    "@react-router/fs-routes": "7.14.0",
    "@shopify/cli": "3.93.2",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "4.1.0",
    "@shopify/oxygen-workers-types": "^4.1.6",
    "@shopify/prettier-config": "^1.1.2",
    "@tailwindcss/vite": "^4.1.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/eslint": "^9.6.1",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "graphql-config": "^5.0.3",
    "prettier": "^3.4.2",
    "typescript": "^5.9.2",
    "vite": "^8.0.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": "^22 || ^24"
  },
  "browserslist": [
    "defaults"
  ]
}
