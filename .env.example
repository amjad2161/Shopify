# Copy to .env — live Shopify store credentials are required (mock.shop is disabled).
# After linking: npx shopify hydrogen env pull --force

SESSION_SECRET=replace-with-random-string
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_API_TOKEN=

