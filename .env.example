# Copy to .env — live Shopify store credentials are required (mock.shop is disabled).
# After linking: npm run store:env

SESSION_SECRET=replace-with-random-string
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_API_TOKEN=

# Optional storefront tuning
# PUBLIC_BRAND_URL=https://your-custom-domain.com
# FEATURED_COLLECTION_HANDLE=frontpage
# FEATURED_COLLECTION_HANDLES=trending-now,beauty-grooming,technology,gaming

# Catalog & dropship automation (Admin API — custom app scopes: write_products, write_collections)
# SHOPIFY_ADMIN_ACCESS_TOKEN=
# CATALOG_SYNC_ENABLED=0
# CATALOG_DRY_RUN=1
# CATALOG_DEFAULT_VENDOR=Lumen Atelier
# CATALOG_MARGIN_PERCENT=45
# CATALOG_SUPPLIER_CSV_PATH=scripts/catalog/feeds/example-products.csv
# GENERIC_SUPPLIER_API_URL=
# GENERIC_SUPPLIER_API_KEY=
# CJ_DROPSHIPPING_API_KEY=
# SPOCKET_API_KEY=
# ALIEXPRESS_APP_KEY=

# Optional — populated automatically by `shopify hydrogen env pull`
# PRIVATE_STOREFRONT_API_TOKEN=
# PUBLIC_STOREFRONT_ID=
# PUBLIC_CHECKOUT_DOMAIN=
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
# PUBLIC_CUSTOMER_ACCOUNT_API_URL=
# SHOP_ID=
