# Copy to .env — live Shopify store credentials are required (mock.shop is disabled).
# After linking: npm run store:env

SESSION_SECRET=replace-with-random-string
PUBLIC_STORE_DOMAIN=
PUBLIC_STOREFRONT_API_TOKEN=

# Optional storefront tuning
# PUBLIC_BRAND_URL=https://your-custom-domain.com
# FEATURED_COLLECTION_HANDLE=frontpage

# Optional — populated automatically by `shopify hydrogen env pull`
# PRIVATE_STOREFRONT_API_TOKEN=
# PUBLIC_STOREFRONT_ID=
# PUBLIC_CHECKOUT_DOMAIN=
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
# PUBLIC_CUSTOMER_ACCOUNT_API_URL=
# SHOP_ID=
